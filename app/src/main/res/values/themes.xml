<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      DayNight follows the system setting, so the launch window matches the
      device theme instead of flashing white before Compose draws.
      windowBackground is what the splash actually paints.
    -->
    <style name="Theme.RealBuds" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
